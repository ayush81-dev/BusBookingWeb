<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Available Buses</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        #map { height: 400px; border-radius: 15px; margin: 20px 0; }
    </style>
</head>
<body>
    <nav>
        <div class="logo">🚌 BusBook</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        </div>
    </nav>

    <div class="container">
        <h2>Available Buses</h2>

        <div id="map"></div>

        <div class="bus-grid">
            <% buses.forEach(bus => { %>
            <div class="bus-card" onclick="showRoute('<%= bus.from_city %>', '<%= bus.to_city %>')">
                <h3>🚌 <%= bus.bus_name %></h3>
                <p>📍 <%= bus.from_city %> → <%= bus.to_city %></p>
                <p>🕐 Departure: <%= bus.departure_time %></p>
                <p>💺 Seats Available: <%= bus.available_seats %></p>
                <p>💰 Fare: Rs.<%= bus.fare %> per seat</p>
                <form action="/book" method="POST">
                    <input type="hidden" name="bus_id" value="<%= bus.id %>">
                    <input type="number" name="seats" placeholder="Seats" min="1" max="<%= bus.available_seats %>" required>
                    <button type="submit" class="btn">Book Now</button>
                </form>
            </div>
            <% }) %>
        </div>
    </div>

    <script>
        const cityCoords = {
            'Ranchi': [23.3441, 85.3096],
            'Bhubaneswar': [20.2961, 85.8245],
            'Patna': [25.5941, 85.1376],
            'Delhi': [28.6139, 77.2090],
            'Mumbai': [19.0760, 72.8777],
            'Pune': [18.5204, 73.8567],
            'Jaipur': [26.9124, 75.7873],
            'Chennai': [13.0827, 80.2707],
            'Bangalore': [12.9716, 77.5946]
        };

        const map = L.map('map').setView([22.5, 82.5], 5);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        let currentLine = null;
        let markers = [];

        function showRoute(from, to) {
            if (currentLine) map.removeLayer(currentLine);
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            const fromCoord = cityCoords[from];
            const toCoord = cityCoords[to];

            if (fromCoord && toCoord) {
                currentLine = L.polyline([fromCoord, toCoord], {
                    color: '#667eea',
                    weight: 4,
                    dashArray: '10, 5'
                }).addTo(map);

                markers.push(L.marker(fromCoord).addTo(map).bindPopup(`🚌 From: ${from}`).openPopup());
                markers.push(L.marker(toCoord).addTo(map).bindPopup(`📍 To: ${to}`));

                map.fitBounds([fromCoord, toCoord], {padding: [50, 50]});
            }
        }
    </script>
</body>
</html>